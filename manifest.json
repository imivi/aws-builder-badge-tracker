{
  "manifest_version": 3,
  "name": "AWS Builder Badges Tracker",
  "version": "1.0.0",
  "description": "Track badge progress, daily & weekly streaks, and missed days on AWS Builder Center.",
  "browser_specific_settings": {
    "gecko": {
      "id": "aws-builder-badges@tracker",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://builder.aws.com/*"
  ],
  "action": {
    "default_title": "AWS Builder Badges Tracker",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": [
      "common/badges-data.js",
      "common/streak-manager.js",
      "common/storage.js",
      "background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://builder.aws.com/*"
      ],
      "css": [
        "content/content.css"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

